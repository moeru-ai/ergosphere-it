{
  "name": "@ergosphere-it/root",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "Signed shell updates and over-the-air core updates for desktop apps",
  "author": {
    "name": "Moeru AI Project AIRI Team",
    "email": "airi@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "homepage": "https://github.com/moeru-ai/ergosphere-it",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/ergosphere-it.git"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache . --fix",
    "spellcheck": "cspell .",
    "typecheck": "pnpm -rF=\"./packages/*\" -F=\"./examples/*\" --parallel typecheck",
    "publint": "pnpm -rF=\"./packages/*\" exec publint",
    "knip": "knip",
    "publish:lib": "pnpm -r publish --access public --no-git-checks",
    "up": "taze -w -r -I && pnpm prune && pnpm dedupe",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@moeru/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "bumpp": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "nano-staged": "catalog:",
    "publint": "catalog:",
    "simple-git-hooks": "catalog:",
    "taze": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*": "eslint --cache --fix"
  }
}
