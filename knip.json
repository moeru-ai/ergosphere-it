{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "ditto",
    "pkill",
    "Xvfb"
  ],
  "workspaces": {
    "examples/electron-app": {
      "entry": [
        "ergo.config.ts"
      ]
    },
    "examples/electron-sparkle-app": {
      "entry": [
        "electron-builder.config.ts",
        "ergo.config.ts"
      ]
    },
    "packages/protocol": {
      "entry": [
        "scripts/*.ts"
      ]
    },
    "tests/electron": {
      "entry": [
        "ergo.config.ts",
        "src/launcher.ts",
        "src/main.ts",
        "src/use-updates-shim.ts"
      ]
    }
  }
}
