{
  "name": "@ergosphere-it/driver-electron",
  "type": "module",
  "version": "0.0.0",
  "description": "The Electron driver of ergosphere-it: the shell that boots a core, and the core API with reload, restart, and rollback",
  "author": {
    "name": "Moeru AI Project AIRI Team",
    "email": "airi@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "homepage": "https://github.com/moeru-ai/ergosphere-it",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/ergosphere-it.git",
    "directory": "packages/driver-electron"
  },
  "exports": {
    "./core": {
      "types": "./dist/core.d.mts",
      "default": "./dist/core.mjs"
    },
    "./electron-updater": {
      "types": "./dist/electron-updater.d.mts",
      "default": "./dist/electron-updater.mjs"
    },
    "./shell": {
      "types": "./dist/shell.d.mts",
      "default": "./dist/shell.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "electron": ">=38",
    "electron-updater": "^6.8.9"
  },
  "peerDependenciesMeta": {
    "electron-updater": {
      "optional": true
    }
  },
  "dependencies": {
    "@ergosphere-it/client": "workspace:*",
    "@ergosphere-it/protocol": "workspace:*",
    "@moeru/std": "catalog:"
  },
  "devDependencies": {
    "@ergosphere-it/publish": "workspace:*",
    "electron": "catalog:",
    "electron-updater": "catalog:"
  }
}
