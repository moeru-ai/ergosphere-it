{
  "name": "@ergosphere-it/server",
  "type": "module",
  "version": "0.0.8",
  "description": "An in-memory server for ergosphere-it update trees, with a release console for local tests and demos",
  "author": {
    "name": "Moeru AI Project AIRI Team",
    "email": "airi@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "homepage": "https://github.com/moeru-ai/ergosphere-it",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/ergosphere-it.git",
    "directory": "packages/server"
  },
  "exports": {
    ".": {
      "@ergosphere-it/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ergosphere-it/protocol": "workspace:*",
    "@ergosphere-it/publish": "workspace:*",
    "@hono/node-server": "catalog:",
    "@moeru/std": "catalog:",
    "es-toolkit": "catalog:",
    "hono": "catalog:",
    "valibot": "catalog:"
  }
}
