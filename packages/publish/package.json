{
  "name": "@ergosphere-it/publish",
  "type": "module",
  "version": "0.0.9",
  "description": "Publishing library of ergosphere-it: create keys, pack and sign cores, and write channel pointers",
  "author": {
    "name": "Moeru AI Project AIRI Team",
    "email": "airi@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "homepage": "https://github.com/moeru-ai/ergosphere-it",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/ergosphere-it.git",
    "directory": "packages/publish"
  },
  "exports": {
    ".": {
      "@ergosphere-it/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ergosphere-it/protocol": "workspace:*",
    "es-toolkit": "catalog:",
    "yaml": "catalog:"
  }
}
