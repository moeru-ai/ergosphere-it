{
  "name": "@ergosphere-it/electron",
  "type": "module",
  "version": "0.0.9",
  "description": "Over-the-air updates for Electron apps: an electron-vite plugin, a generated launcher, a small updater API for main, and a publish command",
  "author": {
    "name": "Moeru AI Project AIRI Team",
    "email": "airi@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "homepage": "https://github.com/moeru-ai/ergosphere-it",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/ergosphere-it.git",
    "directory": "packages/electron"
  },
  "exports": {
    "./config": {
      "@ergosphere-it/source": "./src/define-config.ts",
      "types": "./dist/config.d.mts",
      "default": "./dist/config.mjs"
    },
    "./electron-updater": {
      "@ergosphere-it/source": "./src/electron-updater.ts",
      "types": "./dist/electron-updater.d.mts",
      "default": "./dist/electron-updater.mjs"
    },
    "./launcher": {
      "@ergosphere-it/source": "./src/launcher.ts",
      "types": "./dist/launcher.d.mts",
      "default": "./dist/launcher.mjs"
    },
    "./main": {
      "@ergosphere-it/source": "./src/main.ts",
      "types": "./dist/main.d.mts",
      "default": "./dist/main.mjs"
    },
    "./release": {
      "@ergosphere-it/source": "./src/release.ts",
      "types": "./dist/release.d.mts",
      "default": "./dist/release.mjs"
    },
    "./sparkle": {
      "@ergosphere-it/source": "./src/sparkle.ts",
      "types": "./dist/sparkle.d.mts",
      "default": "./dist/sparkle.mjs"
    },
    "./storage/s3": {
      "@ergosphere-it/source": "./src/storage/s3.ts",
      "types": "./dist/storage/s3.d.mts",
      "default": "./dist/storage/s3.mjs"
    },
    "./types": {
      "@ergosphere-it/source": "./src/types.ts",
      "types": "./dist/types.d.mts",
      "default": "./dist/types.mjs"
    },
    "./virtual": {
      "types": "./virtual.d.ts"
    },
    "./vite/main": {
      "@ergosphere-it/source": "./src/vite/main.ts",
      "types": "./dist/vite/main.d.mts",
      "default": "./dist/vite/main.mjs"
    },
    "./vite/preload": {
      "@ergosphere-it/source": "./src/vite/preload.ts",
      "types": "./dist/vite/preload.d.mts",
      "default": "./dist/vite/preload.mjs"
    },
    "./vite/renderer": {
      "@ergosphere-it/source": "./src/vite/renderer.ts",
      "types": "./dist/vite/renderer.d.mts",
      "default": "./dist/vite/renderer.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ergosphere-it": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "virtual.d.ts"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "electron": ">=38",
    "electron-sparkle-updater": "^0.5.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^6.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "electron-sparkle-updater": {
      "optional": true
    },
    "electron-updater": {
      "optional": true
    },
    "electron-vite": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@ergosphere-it/client": "workspace:*",
    "@ergosphere-it/protocol": "workspace:*",
    "@ergosphere-it/publish": "workspace:*",
    "@moeru/std": "catalog:",
    "s3mini": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@guiiai/logg": "catalog:",
    "electron": "catalog:",
    "electron-sparkle-updater": "catalog:",
    "electron-updater": "catalog:",
    "electron-vite": "catalog:",
    "vite": "catalog:",
    "yaml": "catalog:"
  }
}
