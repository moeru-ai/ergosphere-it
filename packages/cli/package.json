{
  "name": "ergosphere-it",
  "type": "module",
  "version": "0.0.0",
  "description": "Publish CLI of ergosphere-it: pack and sign cores, move channel pointers, and serve update trees",
  "author": {
    "name": "Moeru AI Project AIRI Team",
    "email": "airi@moeru.ai",
    "url": "https://github.com/moeru-ai"
  },
  "license": "MIT",
  "homepage": "https://github.com/moeru-ai/ergosphere-it",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeru-ai/ergosphere-it.git",
    "directory": "packages/cli"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "ergosphere-it": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ergosphere-it/protocol": "workspace:*",
    "@ergosphere-it/publish": "workspace:*",
    "@ergosphere-it/server": "workspace:*",
    "cac": "catalog:"
  }
}
